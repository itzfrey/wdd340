<header id="top-header">
    <span class="siteName">
        <a href="/" title="Return to home page">CSE Motors</a>
    </span>
    <div id="tools">
 <!-- Show Welcome link ONLY when logged in -->
        <% if (locals.accountData) { %>
            <a href="/account" title="Go to account management">
                Welcome <%= accountData.account_firstname %>
            </a>
        <% } %>

        <!-- Show My Account ONLY when NOT logged in -->
        <% if (!locals.accountData) { %>
            <a title="Click to log in" href="/account/login">My Account</a>
        <% } %>

        <!-- Show Logout ONLY when logged in -->
        <% if (locals.accountData) { %>
            <a title="Click to log out" href="/account/logout">Logout</a>
        <% } %>
    </div>
</header>