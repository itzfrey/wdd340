<% if (title) { %>
  <h1><%= title %></h1>
<% } else { %>
  <h1>Account Management</h1>
<% } %>

<!-- Display validation errors -->
<% if (errors) { %>
  <ul class="notice">
    <% errors.array().forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>

<!-- Flash Messages -->
<%- messages() %>

<div class="account-content">
  <!-- Greeting with first name for all account types -->
  <h2>Welcome <%= accountData.account_firstname %></h2>
  
  <!-- Update Account Information link - visible to ALL account types -->
  <p>
    <a href="/account/update/<%= accountData.account_id %>" title="Update your account information">Update Account Information</a>
  </p>
  
  <!-- Inventory Management section - ONLY for Employee or Admin -->
  <% if (accountData.account_type === "Employee" || accountData.account_type === "Admin") { %>
    <h3>Inventory Management</h3>
    <p>
      <a href="/inv/" title="Manage vehicle inventory">Manage Inventory</a>
    </p>
  <% } %>

    <!-- Pending Approvals - ONLY for Admin -->
  <% if (accountData.account_type === "Admin") { %>
    <h3>Administrator Tools</h3>
    <p>
      <a href="/admin/approvals" title="Review pending items">Pending Approvals</a>
    </p>
  <% } %>
</div>